# SearchLab API settings. Copy to services/api/.env and edit:
#   cp services/api/.env.example services/api/.env
# services/api/.env is gitignored and never copied into the Docker image.

# OpenAI key, used only to embed NEW questions (and to build the corpus or labels).
# Optional: without it, saved example questions work and new questions fall back to BM25.
# The value below is a fake placeholder. Replace it with your own key, or delete the line.
OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY_0000000000

# Optional settings. Leave them commented out to use the defaults.

# Which corpus to serve: nasa (default) or github-docs (the archived v1).
# SEARCHLAB_CORPUS=nasa

# Qdrant server URL. Unset = in-memory Qdrant (fine for local dev).
# Docker Compose sets this to http://qdrant:6333 for you.
# QDRANT_URL=http://localhost:6333

# Comma-separated browser origins allowed to call the API. Default: http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
