# SearchLab web settings. Copy to apps/web/.env.local and edit:
#   cp apps/web/.env.example apps/web/.env.local

# Where the browser reaches the API. Default: http://localhost:8000
# NEXT_PUBLIC_API_URL is read at build time, so rebuild after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL for the Playwright end-to-end tests. Default: http://localhost:3000
# E2E_BASE_URL=http://localhost:3000
